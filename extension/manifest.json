{
  "manifest_version": 3,
  "name": "FormatLens",
  "version": "1.0.1",
  "description": "Format JSON and technical text in a private, local-only browser side panel.",
  "author": "Sayan Pramanik",
  "homepage_url": "https://sayanpramanik2012.github.io/FormatLens-Extension/",
  "permissions": ["scripting", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Open FormatLens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
